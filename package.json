{
  "name": "shotdoc",
  "version": "0.1.0",
  "description": "Build documentation from Markdown with browser-driving blocks and screenshots",
  "type": "module",
  "bin": {
    "shotdoc": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "markdown-it": "^15.0.3",
    "playwright": "^1.65.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
