{
  "name": "shotdoc",
  "version": "0.1.0",
  "description": "Build documentation from Markdown with browser-driving blocks and screenshots",
  "keywords": [
    "documentation",
    "screenshots",
    "playwright",
    "markdown",
    "docs-as-code"
  ],
  "license": "MIT",
  "author": "Codiform",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codiform/shotdoc.git"
  },
  "homepage": "https://github.com/codiform/shotdoc#readme",
  "bugs": {
    "url": "https://github.com/codiform/shotdoc/issues"
  },
  "type": "module",
  "bin": {
    "shotdoc": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepack": "npm run build",
    "prepublishOnly": "npm test",
    "build": "tsc -p tsconfig.build.json",
    "build:examples": "npm run build && node scripts/build-examples.mjs",
    "smoke:package": "node scripts/smoke-package.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check",
    "format": "biome check --write"
  },
  "dependencies": {
    "markdown-it": "^15.0.3",
    "playwright": "^1.65.0",
    "pngjs": "^7.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
